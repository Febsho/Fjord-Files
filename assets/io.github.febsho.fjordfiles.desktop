[Desktop Entry]
Type=Application
Name=Fjord Files
GenericName=File Manager
Comment=Browse files and folders
Exec=fjord-files %U
Icon=io.github.febsho.fjordfiles
Terminal=false
Categories=System;FileTools;FileManager;Qt;
Keywords=files;folders;browse;explorer;
MimeType=inode/directory;x-scheme-handler/trash;x-scheme-handler/sftp;x-scheme-handler/smb;
StartupNotify=true
StartupWMClass=io.github.febsho.fjordfiles
Actions=new-window;

[Desktop Action new-window]
Name=New Window
Exec=fjord-files --new-window %U
